# Frontend production env vars (consumed by Vite at build time)
# ATENÇÃO: variáveis aqui são embutidas no bundle JS no momento do build.
# Nunca coloque segredos aqui — apenas variáveis com prefixo VITE_ e não-secretas.
VITE_API_URL=/api

# Opcional: URL pública para webhooks (ex.: https://seu-dominio.com)
# VITE_PUBLIC_URL="https://seu-dominio.com"

# Opcional: chave do Google Maps (aparece no bundle; use restrição de referrer/HTTP referrer)
# VITE_GOOGLE_MAPS_API_KEY=""
