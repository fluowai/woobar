# Gemini API Key (consumida server-side via proxy, NÃO exposta ao frontend)
GEMINI_API_KEY=""

# API URL for the backend server (base already includes /api, no trailing slash)
VITE_API_URL="http://localhost:3001/api"

# Optional: WebSocket URL override (default is derived from VITE_API_URL)
# VITE_WS_URL="ws://localhost:3001/ws"

# Optional: public base URL used to build webhook URLs shown to external
# platforms (iFood, Uber, etc.). Defaults to window.location.origin.
# VITE_PUBLIC_URL="https://seu-dominio.com"

# Google Maps API key for delivery tracking
VITE_GOOGLE_MAPS_API_KEY=""

APP_URL="http://localhost:3000"

# === Backend (server/) ===
# Segredo JWT (obrigatório em produção, mínimo 32 caracteres)
JWT_SECRET=""
# Origem permitida no CORS (vários separados por vírgula em produção)
# CORS_ORIGIN="https://seu-dominio.com"
# Backups do SQLite (padrão: a cada 24h, mantendo os 14 últimos em data/backups)
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
# BACKUP_DIR="/app/data/backups"

# === Fiscal (sidecar sped-nfe) ===
# URL interna do serviço PHP de emissão de NFC-e (rede do docker-compose)
# FISCAL_URL="http://fiscal:8080"
# Token compartilhado entre o Node e o sidecar fiscal
FISCAL_TOKEN=""
