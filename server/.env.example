# Runtime environment for the production API container.
# Never commit the real values from this file.
NODE_ENV=production
PORT=3001
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
DATABASE_PATH=/app/data/woobar.db
APP_URL=https://woobar.wootech.com.br
CORS_ORIGIN=https://woobar.wootech.com.br
FISCAL_URL=http://fiscal:8080
FISCAL_TOKEN=replace-with-a-strong-shared-token
# Optional first-deploy bootstrap. Both must be set together.
MEGA_ADMIN_EMAIL=opauloargolo@gmail.com
MEGA_ADMIN_PASSWORD=replace-with-a-strong-password

